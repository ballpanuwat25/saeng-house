# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# full-size photo sources (re-export with scripts/export-photos.py)
/design/photos-src/
/design/mockups/
/design/_scratch/
/.next-dev/

# OpenStreetMap download for scripts/build-map.mjs
/scripts/.cache/

# bookings and outgoing emails kept locally when there is no Supabase or Resend (src/lib/booking)
/.data/
